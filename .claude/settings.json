{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git pull --rebase --autostash 2>&1 | tail -1 || true",
            "timeout": 30,
            "statusMessage": "Syncing with origin/main..."
          }
        ]
      }
    ]
  }
}
